[Unit]
Description=Nova node first-boot installer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/run/nova/env
# Everything the installer prints goes to the journal AND to the log file that
# logstream.sh mirrors to the container's stdout. Without the second copy an
# operator running `docker compose logs -f nova-node` sees nothing at all, which
# is how a working install looked like a dead container in the field. pipefail
# keeps the installer's own exit status, not tee's, so Restart= still works.
ExecStart=/bin/bash -o pipefail -c '/opt/nova/firstboot.sh 2>&1 | tee -a /var/log/nova-firstboot.log'
# First boot also repairs a recreated container whose persistent marker and
# database survived but whose image-layer runtime did not.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
