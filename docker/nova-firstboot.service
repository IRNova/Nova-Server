[Unit]
Description=Nova node first-boot installer
After=network-online.target
Wants=network-online.target
# Skip once the node is installed on the persistent volume.
ConditionPathExists=!/var/lib/nova/.docker-installed

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=-/run/nova/env
ExecStart=/opt/nova/firstboot.sh
# If the install fails (for example no network yet), let systemd retry.
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
