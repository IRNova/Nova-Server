# Copy to .env and fill in what you need. All keys are optional.
# See docker/README.md for what each one does.

# Panel admin password (blank = generate one, persist it across retries, and print it in the log).
NOVA_ADMIN_PASS=

# A domain pointing at this host -> free Let's Encrypt certificate.
# Blank = the host IP with a self-signed certificate (the app connects either way).
NOVA_DOMAIN=
NOVA_DOMAIN_EMAIL=

# Secret panel subpath. Blank = a random one is generated. "none" = panel at the root.
NOVA_PANEL_PATH=

# Optional extra HTTPS port that only serves the panel (for example 2053).
NOVA_PANEL_PORT=
